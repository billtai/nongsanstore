FLASK_DEBUG=false
PORT=5000
DATABASE_URL=postgresql+psycopg://nong_san:change_me@localhost:5432/nong_san
FRONTEND_ORIGIN=http://localhost:3000
SECRET_KEY=replace_with_a_long_random_secret
# Chỉ dùng khóa môi trường Test. Để trống thì ẩn phương thức MoMo.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
# HTTPS công khai tới backend; localhost không nhận được IPN từ MoMo.
MOMO_IPN_URL=
# MoMo quay về trang chi tiết đơn; {order_id} được thay bằng ID thực.
MOMO_REDIRECT_URL=
# Cổng thanh toán SePay Sandbox. Merchant Secret Key khác với IPN Secret Key.
SEPAY_MERCHANT_ID=
SEPAY_SECRET_KEY=
SEPAY_IPN_SECRET_KEY=
# Tùy chọn; URL HTTPS trang chi tiết đơn với {order_id} khi đã có domain.
SEPAY_RETURN_URL=
# QR chuyển khoản trực tiếp bằng tài khoản ngân hàng liên kết SePay.
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
# API Key của webhook biến động số dư, cấu hình cùng giá trị trên SePay.
SEPAY_BANK_WEBHOOK_API_KEY=
# Redis chưa được dùng trong MVP. Chỉ cấu hình khi thêm tính năng cần Redis.
# REDIS_URL=redis://localhost:6379/0
